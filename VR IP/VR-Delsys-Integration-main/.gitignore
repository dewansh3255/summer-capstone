.AppleDouble

# Compiled binaries — not source code
Unity/BuildVersions/
Unity/BuildVersions/**

# NuGet packages — restored automatically by dotnet restore / NuGet
C# .NET/DelsysAPI/*.nupkg

# DLL dependencies for Python demo — large, restored from Delsys SDK
Python/resources/*.dll
Python/resources/*.DLL

# File reading example data and DLLs — large binary files
